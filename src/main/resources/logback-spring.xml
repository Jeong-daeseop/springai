<?xml version="1.0" encoding="UTF-8"?>
<!--
  MCP Streamable HTTP 서버의 구조화 JSON logback 설정.
  Console appender를 제거하고 운영 이벤트를 파일에 JSON Lines로 기록한다.
  모든 로그는 /tmp/springai-mcp.log 파일에만 기록된다.
-->
<configuration>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="com.krdevops.springai.config.SoLingerLogFilter"/>
        <file>/tmp/springai-mcp.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>/tmp/springai-mcp.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>3</maxHistory>
        </rollingPolicy>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.krdevops.springai.config.observability.StructuredJsonLogLayout"/>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE" />
        <!-- Console appender 없음: stdout은 JSON-RPC 전용 -->
    </root>

</configuration>
