<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="egovframework.let.emp.service.impl.EmployerMapper">

    <!-- @region:binding:resultMap start -->
    <resultMap id="employerMap" type="egovframework.let.emp.service.EmployerVO">
        <id property="emplyrId" column="EMPLYR_ID"/>
        <result property="emplyrNm" column="EMPLYR_NM"/>
        <result property="emailAdres" column="EMAIL_ADRES"/>
        <result property="ofcpsNm" column="OFCPS_NM"/>
        <result property="frstRegistPnttm" column="FRST_REGIST_PNTTM"/>
        <result property="lastUpdtPnttm" column="LAST_UPDT_PNTTM"/>
    </resultMap>
    <!-- @region:binding:resultMap end -->

    <!-- 검색 조건 -->
    <sql id="searchCondition">
        <where>
            <if test="searchKeyword != null and searchKeyword != ''">
                <choose>
                    <when test="searchCondition == '1'">
                        AND EMPLYR_ID LIKE CONCAT('%', #{searchKeyword}, '%')
                    </when>
                    <otherwise>
                        AND EMPLYR_ID LIKE CONCAT('%', #{searchKeyword}, '%')
                    </otherwise>
                </choose>
            </if>
        </where>
    </sql>

    <!-- 목록 조회 -->
    <select id="selectEmployerList" parameterType="egovframework.let.emp.service.EmployerVO"
            resultMap="employerMap">
        SELECT EMPLYR_ID, EMPLYR_NM, EMAIL_ADRES, OFCPS_NM, FRST_REGIST_PNTTM, LAST_UPDT_PNTTM
        FROM LETTNEMPLYRINFO
        <include refid="searchCondition"/>
        ORDER BY EMPLYR_ID DESC
        LIMIT #{paginationInfo.firstRecordIndex}, #{paginationInfo.recordCountPerPage}
    </select>

    <!-- 전체 건수 -->
    <select id="selectEmployerListTotCnt" parameterType="egovframework.let.emp.service.EmployerVO"
            resultType="int">
        SELECT COUNT(*)
        FROM LETTNEMPLYRINFO
        <include refid="searchCondition"/>
    </select>

    <!-- 단건 조회 -->
    <select id="selectEmployer" parameterType="egovframework.let.emp.service.EmployerVO"
            resultMap="employerMap">
        SELECT EMPLYR_ID, EMPLYR_NM, EMAIL_ADRES, OFCPS_NM, FRST_REGIST_PNTTM, LAST_UPDT_PNTTM
        FROM LETTNEMPLYRINFO
        WHERE EMPLYR_ID = #{emplyrId}
    </select>

    <!-- 등록 -->
    <insert id="insertEmployer" parameterType="egovframework.let.emp.service.EmployerVO">
        INSERT INTO LETTNEMPLYRINFO (
            EMPLYR_ID, EMPLYR_NM, EMAIL_ADRES, OFCPS_NM, FRST_REGIST_PNTTM, LAST_UPDT_PNTTM
        ) VALUES (
            #{emplyrId, jdbcType=VARCHAR}, #{emplyrNm, jdbcType=VARCHAR}, #{emailAdres, jdbcType=VARCHAR}, #{ofcpsNm, jdbcType=VARCHAR}, #{frstRegistPnttm, jdbcType=TIMESTAMP}, #{lastUpdtPnttm, jdbcType=TIMESTAMP}
        )
    </insert>

    <!-- 수정 -->
    <update id="updateEmployer" parameterType="egovframework.let.emp.service.EmployerVO">
        UPDATE LETTNEMPLYRINFO
        <set>
            EMPLYR_NM = #{emplyrNm, jdbcType=VARCHAR},
            EMAIL_ADRES = #{emailAdres, jdbcType=VARCHAR},
            OFCPS_NM = #{ofcpsNm, jdbcType=VARCHAR},
            FRST_REGIST_PNTTM = #{frstRegistPnttm, jdbcType=TIMESTAMP},
            LAST_UPDT_PNTTM = #{lastUpdtPnttm, jdbcType=TIMESTAMP}
        </set>
        WHERE EMPLYR_ID = #{emplyrId}
    </update>

    <!-- 삭제 -->
    <delete id="deleteEmployer" parameterType="egovframework.let.emp.service.EmployerVO">
        DELETE FROM LETTNEMPLYRINFO
        WHERE EMPLYR_ID = #{emplyrId}
    </delete>

</mapper>
