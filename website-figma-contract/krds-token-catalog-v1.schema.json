{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.krdevops.local/krds-token-catalog-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "colors", "typography", "spacing", "radius"],
  "properties": {
    "catalogVersion": {"type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"},
    "colors": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/color"}},
    "typography": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/typeStyle"}},
    "spacing": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
    "radius": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "revision", "contentHash", "syncedAt"],
      "properties": {
        "kind": {"enum": ["OFFICIAL_DESIGN_SYSTEM", "CHECKED_IN_SNAPSHOT"]},
        "uri": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "syncedAt": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "typeStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamily", "fontSizePx", "fontWeight", "lineHeightPx"],
      "properties": {
        "fontFamily": {"type": "string", "minLength": 1},
        "fontSizePx": {"type": "integer", "minimum": 1},
        "fontWeight": {"type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100},
        "lineHeightPx": {"type": "integer", "minimum": 1}
      }
    }
  }
}
