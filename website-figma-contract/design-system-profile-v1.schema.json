{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.krdevops.local/design-system-profile-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "registryVersion", "status", "components", "variables"],
  "properties": {
    "id": {"$ref": "https://schemas.krdevops.local/figma-common-v1#/$defs/identifier"},
    "name": {"type": "string", "minLength": 1},
    "version": {"$ref": "https://schemas.krdevops.local/figma-common-v1#/$defs/versionToken"},
    "registryVersion": {"$ref": "https://schemas.krdevops.local/figma-common-v1#/$defs/versionToken"},
    "libraryFileKey": {"type": ["string", "null"]},
    "status": {"enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REJECTED", "PUBLISHED"]},
    "components": {"type": "object", "additionalProperties": {"$ref": "#/$defs/componentBinding"}},
    "variables": {"type": "object", "additionalProperties": {"$ref": "#/$defs/variableBinding"}},
    "overrides": {"$ref": "#/$defs/overrides"}
  },
  "$defs": {
    "bindingStatus": {"enum": ["BOUND", "UNBOUND", "DEPRECATED"]},
    "componentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "componentSetKey": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/bindingStatus"}
      }
    },
    "variableBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "variableId": {"type": ["string", "null"]},
        "collectionName": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/bindingStatus"}
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": {"type": "object", "additionalProperties": {"$ref": "#/$defs/componentOverride"}},
        "variables": {"type": "object", "additionalProperties": {"$ref": "#/$defs/variableOverride"}}
      }
    },
    "componentOverride": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "componentSetKey": {"type": "string", "minLength": 1},
        "variantKeys": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "variableOverride": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "variableId": {"type": "string", "minLength": 1},
        "collectionName": {"type": "string", "minLength": 1}
      }
    }
  }
}
