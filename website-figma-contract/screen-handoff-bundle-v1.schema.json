{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.krdevops.local/screen-handoff-bundle-v1",
  "type": "object", "additionalProperties": false, "required": ["handoffId", "schemaVersion", "contentHash", "operationId", "sourceRevision", "references", "changedFiles", "componentMappings", "tokenBindings", "unresolvedIssues", "reviewDecision", "migrationNotes", "nextAllowedActions"],
  "properties": {
    "handoffId": {"type": "string"}, "schemaVersion": {"const": "1.0"}, "contentHash": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/sha256"}, "operationId": {"type": "string"}, "sourceRevision": {"type": "string"}, "references": {"type": "array", "minItems": 5, "items": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}}, "changedFiles": {"type": "array", "items": {"type": "string"}}, "componentMappings": {"type": "array", "items": {"type": "string"}}, "tokenBindings": {"type": "array", "items": {"type": "string"}}, "unresolvedIssues": {"type": "array", "items": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/issue"}}, "reviewDecision": {"enum": ["APPROVED", "REJECTED"]}, "migrationNotes": {"type": "array", "items": {"type": "string"}}, "rollbackReference": {"anyOf": [{"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}, {"type": "null"}]}, "nextAllowedActions": {"type": "array", "items": {"enum": ["REQUEST_REVISION", "REBUILD_PREVIEW", "RUN_VALIDATION", "APPROVE_REVIEW", "PREVIEW_APPLY", "APPLY_CHANGESET", "ROLLBACK"]}}
