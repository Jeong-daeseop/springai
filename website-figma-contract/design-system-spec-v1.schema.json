{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.krdevops.local/design-system-spec-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "tokens", "variableCollections", "components", "patterns", "issues"],
  "properties": {
    "id": {"$ref": "https://schemas.krdevops.local/figma-common-v1#/$defs/identifier"},
    "name": {"type": "string", "minLength": 1},
    "version": {"$ref": "https://schemas.krdevops.local/figma-common-v1#/$defs/versionToken"},
    "tokens": {"type": "array", "items": {"$ref": "#/$defs/token"}},
    "variableCollections": {"type": "array", "items": {"$ref": "#/$defs/variableCollection"}},
    "components": {"type": "array", "items": {"$ref": "#/$defs/componentDefinition"}},
    "patterns": {"type": "array", "items": {"$ref": "#/$defs/patternDefinition"}},
    "issues": {
      "type": "array",
      "items": {"$ref": "https://schemas.krdevops.local/figma-common-v1#/$defs/designSystemIssue"}
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "name", "value"],
      "properties": {
        "category": {"enum": ["COLOR", "SPACING", "TYPOGRAPHY", "RADIUS", "ELEVATION"]},
        "name": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "variableCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "modes", "valuesByMode"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "modes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "valuesByMode": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}}
      }
    },
    "componentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "properties", "variants"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "lifecycleStatus": {"enum": ["ACTIVE", "DEPRECATED"]},
        "replacementLogicalType": {"type": ["string", "null"]},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "developer": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "codeComponent": {"type": ["string", "null"]},
            "documentationUrl": {"type": ["string", "null"], "format": "uri"},
            "packageName": {"type": ["string", "null"]}
          }
        },
        "layout": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "mode": {"type": "string"},
            "paddingX": {"type": "string"},
            "paddingY": {"type": "string"},
            "gap": {"type": "string"},
            "alignment": {"type": "string"},
            "minWidth": {"type": "string"},
            "maxWidth": {"type": "string"},
            "minHeight": {"type": "string"},
            "maxHeight": {"type": "string"}
          }
        },
        "properties": {"type": "array", "items": {"$ref": "#/$defs/componentProperty"}},
        "variants": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "componentProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["TEXT", "BOOLEAN", "VARIANT", "INSTANCE_SWAP"]},
        "defaultValue": {"type": ["string", "null"]}
      }
    },
    "patternDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "composedOf"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "composedOf": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
