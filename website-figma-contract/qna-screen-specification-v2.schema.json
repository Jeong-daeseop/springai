{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.krdevops.local/qna-screen-specification-v2",
  "type": "object",
  "required": ["id", "version", "status", "screenName", "featureType", "archetype", "database", "primaryTable", "dataSources", "pages", "issues", "layoutDensity", "formColumnLayout", "actionPlacement", "searchPanelPlacement", "createdAt"],
  "properties": {
    "id": {"const": "qna-suite"},
    "version": {"type": "integer", "minimum": 2},
    "status": {"const": "APPROVED"},
    "screenName": {"type": "string", "minLength": 1},
    "featureType": {"const": "QNA"},
    "archetype": {"type": "string", "minLength": 1},
    "database": {"type": "string", "minLength": 1},
    "primaryTable": {"type": "string", "minLength": 1},
    "dataSources": {"type": "array", "minItems": 1},
    "pages": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"$ref": "#/$defs/page"}
    },
    "issues": {"type": "array", "maxItems": 0},
    "layoutDensity": {"enum": ["STANDARD", "COMPACT", "COMFORTABLE"]},
    "formColumnLayout": {"enum": ["SINGLE_COLUMN", "TWO_COLUMN"]},
    "actionPlacement": {"enum": ["TOP_RIGHT", "BOTTOM_RIGHT"]},
    "searchPanelPlacement": {"enum": ["ABOVE_TABLE", "NONE"]},
    "createdAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"}
  },
  "$defs": {
    "role": {"enum": ["page.header", "search.panel", "data.table", "data.table.cell", "data.pagination", "form.container", "form.section", "field.text", "field.textarea", "field.select", "field.checkbox", "action.primary", "action.secondary", "action.destructive"]},
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "template", "fields", "actions", "selectionSource"],
      "properties": {
        "id": {"enum": ["qna-list", "qna-create", "qna-detail", "qna-answer-list", "qna-answer-detail", "qna-answer-create"]},
        "template": {"type": "string", "pattern": "_(LIST|DETAIL|FORM)$"},
        "fields": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/field"}},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
        "selectionSource": {"const": "EXPLICIT"}
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "label", "dataRole", "semanticRole", "mode", "source", "visible", "required", "searchable", "sortable", "control", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "dataRole": {"type": "string", "minLength": 1},
        "semanticRole": {"$ref": "#/$defs/role"},
        "mode": {"enum": ["EDITABLE", "READ_ONLY"]},
        "source": {"type": "object"},
        "visible": {"type": "boolean"},
        "required": {"type": "boolean"},
        "searchable": {"type": "boolean"},
        "sortable": {"type": "boolean"},
        "control": {"enum": ["TEXT", "TEXTAREA", "SELECT", "CHECKBOX", "DATE", "NUMBER"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "command", "role", "label", "state"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "command": {"enum": ["SEARCH", "CREATE", "SAVE", "UPDATE", "DELETE", "CANCEL", "LIST", "BACK", "VIEW_DETAIL"]},
        "role": {"enum": ["action.primary", "action.secondary", "action.destructive"]},
        "label": {"type": "string", "minLength": 1},
        "state": {"enum": ["DEFAULT", "DISABLED", "LOADING"]}
      }
    }
  }
}
