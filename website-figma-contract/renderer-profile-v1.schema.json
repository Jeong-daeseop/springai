{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.krdevops.local/renderer-profile-v1",
  "type": "object", "additionalProperties": false,
  "required": ["profileId", "version", "contentHash", "status", "rendererType", "templateEngine", "templateSetVersion", "templateSetHash", "componentMappingVersion", "supportedFeatures", "forbiddenFallbacks", "outputConventionVersion", "validatorProfile", "supportedViewTypes"],
  "properties": {
    "profileId": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/identifier"}, "version": {"type": "string"}, "contentHash": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/sha256"}, "status": {"enum": ["DRAFT", "APPROVED", "SUPERSEDED"]},
    "rendererType": {"const": "THYMELEAF"}, "templateEngine": {"const": "FREEMARKER"}, "templateSetVersion": {"type": "string"}, "templateSetHash": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/sha256"},
    "componentMappingVersion": {"type": "string"}, "supportedFeatures": {"type": "array", "items": {"type": "string"}}, "forbiddenFallbacks": {"type": "array", "items": {"type": "string"}}, "outputConventionVersion": {"type": "string"}, "validatorProfile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}@[1-9][0-9]*\\.[0-9]+(?:\\.[0-9]+)?#[a-f0-9]{64}$"}, "supportedViewTypes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
