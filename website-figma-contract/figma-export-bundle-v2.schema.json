{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.krdevops.local/figma-export-bundle-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["figmaScreenSpec", "designSystemProfile", "componentRegistry", "screenPattern", "variantRuleSet", "metadata"],
  "properties": {
    "figmaScreenSpec": {"$ref": "https://schemas.krdevops.local/figma-screen-spec-v2"},
    "designSystemProfile": {
      "type": "object", "additionalProperties": false, "required": ["profile", "snapshotAt"],
      "properties": {
        "profile": {"$ref": "https://schemas.krdevops.local/design-system-profile-v1"},
        "snapshotAt": {"type": "string", "format": "date-time"}
      }
    },
    "componentRegistry": {
      "type": "object", "additionalProperties": false, "required": ["registry", "snapshotAt"],
      "properties": {
        "registry": {"$ref": "https://schemas.krdevops.local/component-registry-v2"},
        "snapshotAt": {"type": "string", "format": "date-time"}
      }
    },
    "resolvedComponentRegistry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["profileId", "profileVersion", "registryVersion", "catalogVersion", "catalogHash", "registryHash", "components"],
      "properties": {
        "profileId": {"type": "string", "minLength": 1},
        "profileVersion": {"type": "string", "minLength": 1},
        "registryVersion": {"type": "string", "minLength": 1},
        "catalogVersion": {"type": "string", "minLength": 1},
        "catalogHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "registryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentSetKey", "componentName", "variants", "properties"],
            "properties": {
              "componentSetKey": {"type": "string", "minLength": 1},
              "componentName": {"type": ["string", "null"]},
              "variants": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object", "additionalProperties": false,
                  "required": ["figmaProperty", "type", "values"],
                  "properties": {
                    "figmaProperty": {"type": "string", "minLength": 1},
                    "type": {"enum": ["TEXT", "BOOLEAN", "VARIANT", "INSTANCE_SWAP"]},
                    "values": {"type": "object", "additionalProperties": {"type": "string"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "screenPattern": {
      "type": "object", "additionalProperties": false, "required": ["pattern", "snapshotAt"],
      "properties": {
        "pattern": {"$ref": "https://schemas.krdevops.local/screen-patterns-v1#/$defs/pattern"},
        "snapshotAt": {"type": "string", "format": "date-time"}
      }
    },
    "variantRuleSet": {
      "type": "object", "additionalProperties": false, "required": ["ruleSet", "snapshotAt"],
      "properties": {
        "ruleSet": {"$ref": "https://schemas.krdevops.local/variant-rule-set-v1"},
        "snapshotAt": {"type": "string", "format": "date-time"}
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["exportedAt", "figmaScreenSpecSchemaVersion", "screenSpecificationVersion", "designSystemProfileVersion", "registryVersion", "screenPatternVersion", "variantRuleSetVersion", "componentContractVersion"],
      "properties": {
        "exportedAt": {"type": "string", "format": "date-time"},
        "figmaScreenSpecSchemaVersion": {"const": "figma-screen-spec-v2"},
        "screenSpecificationVersion": {"type": "integer", "minimum": 1},
        "designSystemProfileVersion": {"type": "string", "minLength": 1},
        "registryVersion": {"type": "string", "minLength": 1},
        "screenPatternVersion": {"type": "string", "minLength": 1},
        "variantRuleSetVersion": {"type": "string", "minLength": 1},
        "componentContractVersion": {"type": "string", "minLength": 1},
        "catalogVersion": {"type": ["string", "null"], "minLength": 1},
        "catalogHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "registryHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
