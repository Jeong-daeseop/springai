  "rules": [
{"ruleId":"search-panel-default","priority":100,"role":"search.panel","when":{"pattern":"crud.list","platform":"DESKTOP"},"result":{"type":"simple","size":"Medium","state":"Default"}},
    {"ruleId":"table-cell-body","priority":100,"role":"data.table.cell","when":{"pattern":"crud.list","platform":"DESKTOP"},"result":{"type":"Body"}},

    {"ruleId":"text-editable","priority":100,"role":"field.text","when":{"mode":"EDITABLE","platform":"DESKTOP"},"result":{"size":"Medium","state":"Default"}},
    {"ruleId":"text-readonly","priority":100,"role":"field.text","when":{"mode":"READ_ONLY","platform":"DESKTOP"},"result":{"size":"Medium","state":"ReadOnly"}},
    {"ruleId":"textarea-editable","priority":100,"role":"field.textarea","when":{"mode":"EDITABLE","platform":"DESKTOP"},"result":{"state":"Default"}},
    {"ruleId":"textarea-readonly","priority":100,"role":"field.textarea","when":{"mode":"READ_ONLY","platform":"DESKTOP"},"result":{"state":"ReadOnly"}},
    {"ruleId":"select-editable","priority":100,"role":"field.select","when":{"mode":"EDITABLE","platform":"DESKTOP"},"result":{"size":"Medium","state":"Default"}},
    {"ruleId":"select-readonly","priority":100,"role":"field.select","when":{"mode":"READ_ONLY","platform":"DESKTOP"},"result":{"size":"Medium","state":"ReadOnly"}},
