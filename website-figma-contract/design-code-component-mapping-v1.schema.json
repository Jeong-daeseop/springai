{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.krdevops.local/design-code-component-mapping-v1",
  "type": "object", "additionalProperties": false,
  "required": ["mappingId", "version", "status", "contentHash", "logicalType", "figmaComponentSetKey", "thymeleafFragment", "propertyMappings", "slotMappings", "supportedRendererProfiles", "sourceRevision"],
  "properties": {
    "mappingId": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/identifier"}, "version": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/schemaVersion"},
    "status": {"enum": ["DRAFT", "REVIEW_REQUIRED", "APPROVED", "SUPERSEDED"]}, "contentHash": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/sha256"},
    "logicalType": {"type": "string", "minLength": 1}, "figmaComponentSetKey": {"type": "string", "minLength": 1}, "thymeleafFragment": {"type": "string", "minLength": 1},
    "propertyMappings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["figmaProperty", "fragmentParameter", "required"], "properties": {"figmaProperty": {"type": "string", "minLength": 1}, "fragmentParameter": {"type": "string", "minLength": 1}, "valueMapping": {"type": "object"}, "required": {"type": "boolean"}, "defaultValue": {}, "fallbackValue": {}}}},
    "slotMappings": {"type": "array", "items": {"type": "object", "required": ["figmaSlot", "fragmentSlot"], "properties": {"figmaSlot": {"type": "string"}, "fragmentSlot": {"type": "string"}}, "additionalProperties": false}},
    "fixtureModel": {"type": ["object", "null"]}, "supportedRendererProfiles": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "sourceRevision": {"type": "string", "minLength": 1},
    "approvedBy": {"type": ["string", "null"]}, "approvedAt": {"type": ["string", "null"], "format": "date-time"}
  }
}
