{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.krdevops.local/preview-evidence-bundle-v1",
  "type": "object", "additionalProperties": false, "required": ["bundleId", "schemaVersion", "contentHash", "status", "operationId", "sourceRevision", "fixtureModelHash", "references", "artifacts", "reports", "fallbackAssessments", "warnings", "finalDecision"],
  "properties": {
    "bundleId": {"type": "string"}, "schemaVersion": {"const": "1.0"}, "contentHash": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/sha256"}, "status": {"enum": ["INCOMPLETE", "COMPLETE", "INVALID"]}, "operationId": {"type": "string"}, "sourceRevision": {"type": "string", "minLength": 1}, "fixtureModelHash": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/sha256"},
    "references": {"type": "array", "minItems": 3, "items": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}}, "artifacts": {"type": "array", "items": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}},
    "reports": {"type": "object", "additionalProperties": false, "required": ["binding", "build", "render"], "properties": {"binding": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}, "security": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}, "build": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}, "render": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}, "accessibility": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}, "visualDiff": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}, "interactionFlow": {"$ref": "https://schemas.krdevops.local/pipeline-evolution-common-v1#/$defs/artifactReference"}}},
    "fallbackAssessments": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}, "finalDecision": {"enum": ["PENDING", "PASS", "FAIL"]}
  }
}
