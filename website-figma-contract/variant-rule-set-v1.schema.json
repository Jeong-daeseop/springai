{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.krdevops.local/variant-rule-set-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "profileId", "registryVersion", "status", "rules"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "registryVersion": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "APPROVED", "PUBLISHED", "SUPERSEDED"]},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "role": {
      "enum": ["page.header", "search.panel", "data.table", "data.table.cell", "data.pagination", "form.container", "form.section", "field.text", "field.textarea", "field.select", "field.checkbox", "action.primary", "action.secondary", "action.destructive"]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "priority", "role", "when", "result"],
      "properties": {
        "ruleId": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0},
        "role": {"$ref": "#/$defs/role"},
        "when": {"type": "object", "additionalProperties": {"type": "string"}},
        "result": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
      }
    }
  }
}
