{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.krdevops.local/screen-suite-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["suiteId", "version", "screens"],
  "properties": {
    "suiteId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "screens": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["screenId", "pattern", "required", "viewport", "requiredRoles", "fields", "actions"],
        "properties": {
          "screenId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "pattern": {"enum": ["crud.list", "crud.detail", "crud.create", "crud.edit"]},
          "required": {"type": "boolean"},
          "viewport": {"const": "DESKTOP"},
          "requiredRoles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "fields": {"type": "array", "items": {"type": "string"}},
          "actions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
