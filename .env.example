# 필수 환경변수 — 반드시 설정 후 기동
APP_API_KEY=local-dev-key
OPENAI_API_KEY=sk-proj-여기에_실제_키_입력
DESIGN_VISION_FIGMA_ENABLED=false
# 개인 로컬 도구용 PAT. 최소 file_content:read 권한만 부여하고 저장소에 커밋하지 마세요.
FIGMA_ACCESS_TOKEN=
# 쉼표로 구분한 허용 fileKey. P1에서도 가능하면 대상 파일을 제한하세요.
FIGMA_ALLOWED_FILE_KEYS=
# 신규 FigmaExportTool/DesignSystemTool 호출 시 전달하는 별도 공유 비밀키
FIGMA_MCP_SHARED_SECRET=
# 모든 MCP Tool에 사용하는 공통 transport token. 운영 환경에서는 반드시 비밀 저장소로 주입하세요.
MCP_SHARED_TOKEN=
MCP_AUTH_MODE=REQUIRED
MCP_LEGACY_CREDENTIAL_VALID_UNTIL=
# 회전 유예기간에만 설정하고 만료 직후 제거하세요(예: 2026-08-04T00:00:00Z).
MCP_PREVIOUS_SHARED_TOKEN=
MCP_PREVIOUS_TOKEN_VALID_UNTIL=
SERVER_ADDRESS=127.0.0.1
WEB_CAPTURE_ENABLED=false
WEB_CAPTURE_EXTRACTOR_BASE_URL=http://127.0.0.1:4319
WEB_CAPTURE_EXTRACTOR_API_KEY=
WEB_CAPTURE_DOCUMENT_KEY_SECRET=
WEB_CAPTURE_ARTIFACT_PATH=
EXTRACTOR_LOG_FILE=

# 선택 환경변수 — 기본값 사용 시 생략 가능
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
REDIS_URI=redis://localhost:6379
EGOV_OUTPUT_PATH=/Users/yourname/Desktop/egov-generated
ONNX_MODEL_PATH=/Users/yourname/models/ko-sroberta/model.onnx
ONNX_TOKENIZER_PATH=/Users/yourname/models/ko-sroberta/tokenizer.json
